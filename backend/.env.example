# ── 필수 ───────────────────────────────────────────────────────────────
# GitHub PAT. 이슈 생성에 사용된다. (모델 추론에는 더 이상 쓰이지 않음)
# 필요한 스코프: repo (이슈 생성), read:user
# 운영 환경에서는 이 값을 비워두고 AZURE_KEY_VAULT_URL을 사용할 것.
GITHUB_TOKEN=

# ── 모델 ───────────────────────────────────────────────────────────────
# copilot_sdk   = GitHub Copilot SDK (로컬 기본, agent-framework-github-copilot 필요,
#                 설치 후 `python -m copilot download-runtime` 실행 필요)
# azure_openai  = Azure OpenAI / Azure AI Foundry 배포 (Azure 배포 기본)
MODEL_PROVIDER=copilot_sdk
MODEL_ID=gpt-5-mini
MODEL_ID_FAST=gpt-4o-mini
# AI PR 리뷰에 전달할 diff 최대 문자 수 (초과분은 잘라내고 명시한다).
PR_REVIEW_MAX_DIFF_CHARS=100000

# azure_openai를 쓸 때 필요. MODEL_ID는 모델명이 아니라 "배포 이름"이다.
AZURE_OPENAI_ENDPOINT=
# 비워두면 DefaultAzureCredential(관리 ID / az login)로 인증한다 — 운영 권장.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── 앱 ─────────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# /api 접근 키. 비워두면 로컬에서는 인증 없이 열리고,
# ENVIRONMENT=prod 에서는 /api가 503으로 잠긴다.
# 설정 시 클라이언트는 X-API-Key 헤더로 같은 값을 보내야 한다.
API_KEY=

# ── 파이프라인 ─────────────────────────────────────────────────────────
MAX_RETRIES=2
ISSUE_CREATE_CONCURRENCY=3

# ── 개인정보 ───────────────────────────────────────────────────────────
# true로 바꾸면 회의록 원문이 이력 DB에 저장된다. 기본은 저장 안 함.
PERSIST_TRANSCRIPT=false
HISTORY_ENABLED=true
HISTORY_DB_PATH=data/history.db

# ── Azure (선택) ───────────────────────────────────────────────────────
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
