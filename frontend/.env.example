# 실제 FastAPI 연동이 기본입니다. 백엔드 없는 UI 데모는 mock으로 바꿉니다.
VITE_API_MODE=live

# API prefix를 포함한 URL. 로컬에서는 Vite proxy를 쓰므로 /api를 권장합니다.
VITE_API_URL=/api
VITE_PROXY_TARGET=http://localhost:8000

# backend API_KEY와 동일한 값. 로컬에서 backend API_KEY가 비어 있으면 비워 둡니다.
VITE_API_KEY=

# 채점 경로 기본값입니다. true이면 로그인 화면 없이 데모 사용자로 바로 진입합니다.
VITE_DEMO_BYPASS_AUTH=true
