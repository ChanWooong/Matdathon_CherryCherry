# mock = 백엔드 없이 브라우저에서 에이전트 파이프라인 시뮬레이션 (기본값)
# live = 실제 백엔드 SSE API 사용
VITE_API_MODE=mock

# true 이면 OAuth 없이 데모 사용자로 자동 로그인 (채점/데모용)
VITE_DEMO_BYPASS_AUTH=true

# live 모드에서 사용할 API 베이스 경로 (기본 /api → vite proxy 경유)
VITE_API_BASE=/api

# vite dev 프록시가 붙을 백엔드 주소
VITE_PROXY_TARGET=http://localhost:8000
